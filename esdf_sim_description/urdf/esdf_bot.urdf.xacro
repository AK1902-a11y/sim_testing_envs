<?xml version="1.0"?>
<!--
  esdf_bot: circular differential-drive robot for Gazebo Fortress (ignition-gazebo6).

  TF tree:  odom -> base_footprint -> base_link -> {chassis_link, wheels, casters, lidar_link, imu_link}
  base_footprint is on the ground; base_link is at the wheel axle height.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="esdf_bot">

  <xacro:arg name="lidar_noise" default="0.0"/>   <!-- gaussian stddev [m]; 0 disables -->
  <xacro:arg name="sim_gz" default="true"/>

  <!-- ................ Parameters (config/robot_params.yaml) ................ -->
  <xacro:property name="cfg" value="${xacro.load_yaml('$(find esdf_sim_description)/config/robot_params.yaml')['esdf_bot']}"/>

  <xacro:property name="radius"           value="${cfg['radius']}"/>
  <xacro:property name="chassis_height"   value="${cfg['chassis_height']}"/>
  <xacro:property name="clearance"        value="${cfg['ground_clearance']}"/>
  <xacro:property name="chassis_mass"     value="${cfg['chassis_mass']}"/>
  <xacro:property name="wheel_radius"     value="${cfg['wheel_radius']}"/>
  <xacro:property name="wheel_width"      value="${cfg['wheel_width']}"/>
  <xacro:property name="wheel_sep"        value="${cfg['wheel_separation']}"/>
  <xacro:property name="wheel_mass"       value="${cfg['wheel_mass']}"/>
  <xacro:property name="odom_wheel_sep"   value="${cfg['odom_wheel_separation']}"/>
  <xacro:property name="caster_radius"    value="${cfg['caster_radius']}"/>
  <xacro:property name="caster_x"         value="${cfg['caster_x']}"/>
  <xacro:property name="caster_mass"      value="${cfg['caster_mass']}"/>
  <xacro:property name="lidar_rate"       value="${cfg['lidar']['rate']}"/>
  <xacro:property name="lidar_samples"    value="${cfg['lidar']['samples']}"/>
  <xacro:property name="lidar_min"        value="${cfg['lidar']['min_range']}"/>
  <xacro:property name="lidar_max"        value="${cfg['lidar']['max_range']}"/>
  <xacro:property name="lidar_noise"      value="$(arg lidar_noise)"/>
  <xacro:property name="lidar_radius"     value="0.035"/>
  <xacro:property name="lidar_height"     value="0.05"/>
  <xacro:property name="lidar_mass"       value="0.3"/>

  <!-- ............................ Inertia macros ............................ -->
  <xacro:macro name="cylinder_inertial" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" iyy="${m*(3*r*r+h*h)/12}" izz="${m*r*r/2}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" iyy="${2*m*r*r/5}" izz="${2*m*r*r/5}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ................................ Base ................................ -->
  <link name="base_footprint"/>

  <link name="base_link"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Chassis: cylinder of the robot's footprint radius. Underside is `clearance` above ground. -->
  <link name="chassis_link">
    <visual>
      <geometry><cylinder radius="${radius}" length="${chassis_height}"/></geometry>
      <material name="chassis_blue"><color rgba="0.15 0.35 0.75 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${radius}" length="${chassis_height}"/></geometry>
    </collision>
    <xacro:cylinder_inertial m="${chassis_mass}" r="${radius}" h="${chassis_height}"/>
  </link>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 ${clearance + chassis_height/2 - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ............................... Wheels ............................... -->
  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_dark"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertial m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <!-- roll -90deg: cylinder axis (z) -> +y; positive rotation drives the robot forward -->
      <origin xyz="0 ${y} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel side="left"  y="${ wheel_sep/2}"/>
  <xacro:drive_wheel side="right" y="${-wheel_sep/2}"/>

  <!-- ............................... Casters ............................... -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="wheel_dark"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertial m="${caster_mass}" r="${caster_radius}"/>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${name}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="front" x="${ caster_x}"/>
  <xacro:caster name="rear"  x="${-caster_x}"/>

  <!-- ............................ 2D lidar (top centre) ............................ -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="lidar_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <xacro:cylinder_inertial m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${clearance + chassis_height + lidar_height/2 - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ................................. IMU ................................. -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ............................ Gazebo Fortress ............................ -->
  <xacro:if value="$(arg sim_gz)">

    <gazebo>
      <plugin filename="ignition-gazebo-joint-state-publisher-system"
              name="ignition::gazebo::systems::JointStatePublisher"/>

      <!-- Wheel-based odometry (what Nav2 / SLAM consume): odom -> base_footprint -->
      <plugin filename="ignition-gazebo-diff-drive-system"
              name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${odom_wheel_sep}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        <max_linear_acceleration>3</max_linear_acceleration>
        <min_linear_acceleration>-3</min_linear_acceleration>
        <max_angular_acceleration>6</max_angular_acceleration>
        <min_angular_acceleration>-6</min_angular_acceleration>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
      </plugin>

      <!-- Ground truth from the physics world; for benchmark metrics only. Not published to /tf. -->
      <plugin filename="ignition-gazebo-odometry-publisher-system"
              name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>ground_truth/odom</odom_topic>
        <tf_topic>ground_truth/tf</tf_topic>
        <dimensions>2</dimensions>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </gazebo>

    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <topic>scan</topic>
        <ignition_frame_id>lidar_link</ignition_frame_id>
        <update_rate>${lidar_rate}</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>${lidar_samples}</samples>
              <resolution>1</resolution>
              <min_angle>-${pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${lidar_min}</min>
            <max>${lidar_max}</max>
            <resolution>0.01</resolution>
          </range>
          <xacro:if value="${float(lidar_noise) > 0.0}">
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>${lidar_noise}</stddev>
            </noise>
          </xacro:if>
        </lidar>
      </sensor>
    </gazebo>

    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <topic>imu</topic>
        <ignition_frame_id>imu_link</ignition_frame_id>
        <update_rate>100</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </gazebo>

  </xacro:if>

</robot>
